rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function ownUser() {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create: if signedIn() && request.auth.uid == userId;
      allow read, update, delete: if signedIn() && request.auth.uid == userId;
    }

    // Todos os dados financeiros pertencem ao usuário autenticado.
    // O cliente só pode consultar/criar/alterar/excluir documentos cujo user_id
    // seja exatamente o UID da sessão atual.
    match /{collection}/{documentId} {
      allow read, delete: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if signedIn()
                    && resource.data.user_id == request.auth.uid
                    && request.resource.data.user_id == request.auth.uid;
    }
  }
}
